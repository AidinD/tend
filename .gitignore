node_modules/
out/
dist/
.vite/

# Tend's own data. Holds notes and assessments about named people and never
# belongs in a repository, even a private one.
data/
*.jsonl

npm-debug.log*
*.tsbuildinfo
.DS_Store
Thumbs.db

# Test output: the harness writes these each run.
# The harness shoots one image per view, and every one of them frames whatever
# store it ran against. Listing the three that existed at the time meant the
# next one added would have been committed by whoever ran the suite next.
docs/*.png

dist/
resources/*.tmp

# Screenshot and capture output. Never committed - a screenshot of your own app
# shows whatever was on screen. Helm had seven of these in a public repo before
# anyone noticed; see keel/hooks/no-leaky-assets.mjs.
screenshots/
**/screenshots/
captures/
**/captures/

# Agent scratch state. The goal loop writes its research notes, plan and phase
# here while it works. It is orchestration bookkeeping, not project
# documentation, and a stale plan left in a repository reads like a spec to the
# next person who finds it.
.helm-goal/

# A worktree checked out here is a second full copy of the repository, and its
# `.git` file records the absolute path it was created from - which carries a
# username. Ignored in the repository rather than in `.git/info/exclude`, since
# an exclude file is local to one machine and never reaches a clone.
.claude/worktrees/

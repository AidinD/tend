node_modules/
out/
dist/
.vite/

# Tend's own data. Holds notes and assessments about named people and never
# belongs in a repository, even a private one.
data/
*.jsonl

npm-debug.log*
*.tsbuildinfo
.DS_Store
Thumbs.db

# Test output: the harness writes these each run.
docs/now-view.png
docs/palette.png

dist/
resources/*.tmp

# Screenshot and capture output. Never committed - a screenshot of your own app
# shows whatever was on screen. Helm had seven of these in a public repo before
# anyone noticed; see keel/hooks/no-leaky-assets.mjs.
screenshots/
**/screenshots/
captures/
**/captures/

# Agent scratch state. The goal loop writes its research notes, plan and phase
# here while it works. It is orchestration bookkeeping, not project
# documentation - a stale 24 kB plan in the repo reads like a spec to the next
# person, and this directory reached a public repo once already carrying
# iteration logs and a worktree path. See GITHUB-PUSH.md.
.helm-goal/

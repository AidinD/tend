{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/storage/**/*.js",
    "src/domain/**/*.js",
    "src/service/**/*.js",
    "src/mcp/**/*.js",
    "src/main/**/*.js",
    "test/**/*.mjs",
    "scripts/**/*.mjs"
  ]
}
